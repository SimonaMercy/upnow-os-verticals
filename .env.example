# Copy to .env.local and fill in. .env.local is git-ignored — never commit it.

# API base URL (no trailing slash).
# Frontend-only setup: point at staging.
NEXT_PUBLIC_API_URL=https://staging.upnow.ae/api
# Same value, used server-side by next.config.ts to proxy /uploads/*.
BACKEND_URL=https://staging.upnow.ae/api

# Full-stack setup (backend running locally on :3001):
# NEXT_PUBLIC_API_URL=http://localhost:3001/api
# BACKEND_URL=http://localhost:3001/api

# OAuth — Sign In with Google / Apple (optional for local work)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_APPLE_CLIENT_ID=com.upnow.app
