# Copy to .env.local and fill in. .env.local is git-ignored — never commit it.
#
# The browser never calls the API directly: every request goes to this app's own
# /api route, which forwards server-side to BACKEND_URL and keeps the session in
# an httpOnly cookie. So both values below point at the API itself.

# Frontend-only setup (default): the staging API.
BACKEND_URL=https://upnow-staging-backend-ttxhtr3k2a-ww.a.run.app/api
NEXT_PUBLIC_API_URL=https://upnow-staging-backend-ttxhtr3k2a-ww.a.run.app/api

# Full-stack setup (API running locally on :3001):
# BACKEND_URL=http://localhost:3001/api
# NEXT_PUBLIC_API_URL=http://localhost:3001/api

# OAuth — Sign In with Google / Apple (optional for local work)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_APPLE_CLIENT_ID=com.upnow.app
